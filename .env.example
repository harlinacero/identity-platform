# Copy to .env for local development. Never commit .env.
POSTGRES_USER=identity
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=identity
REDIS_PASSWORD=change-me-local
RABBITMQ_DEFAULT_USER=identity
RABBITMQ_DEFAULT_PASS=change-me-local
LDAP_ADMIN_PASSWORD=change-me-local
LDAP_ORGANISATION=Identity Platform
LDAP_DOMAIN=identity-platform.local
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Change-me-Local-1!

# Identity. The roles are created only when the PostgreSQL volume is empty.
IDENTITY_MIGRATOR_PASSWORD=change-me-local
IDENTITY_APP_PASSWORD=change-me-local
IDENTITY_SESSION_DURATION=00:15:00
# Test users, created only in Development and Testing.
SEED_TENANT_A_USER_PASSWORD=change-me-tenant-a
SEED_TENANT_B_USER_PASSWORD=change-me-tenant-b

# Host ports. Change one if it is already in use on your machine.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=29092
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
OPENSEARCH_PORT=9200
LDAP_PORT=389
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
IDENTITY_PORT=5001
