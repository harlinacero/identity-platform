# Copy to .env for local development. Never commit .env.
POSTGRES_USER=identity
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=identity
REDIS_PASSWORD=change-me-local
RABBITMQ_DEFAULT_USER=identity
RABBITMQ_DEFAULT_PASS=change-me-local
LDAP_ADMIN_PASSWORD=change-me-local
LDAP_ORGANISATION=Identity Platform
LDAP_DOMAIN=identity-platform.local
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Change-me-Local-1!

# Host ports. Change one if it is already in use on your machine.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=29092
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
OPENSEARCH_PORT=9200
LDAP_PORT=389
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
